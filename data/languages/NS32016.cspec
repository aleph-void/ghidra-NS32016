<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
	<absolute_max_alignment value="0" />
	<machine_alignment value="8" />
	<default_alignment value="1" />
	<default_pointer_alignment value="1" />
	<pointer_size value="4" />
	<wchar_size value="4" />
	<short_size value="2" />
	<integer_size value="4" />
	<long_size value="4" />
	<long_long_size value="8" />
	<float_size value="4" />
	<double_size value="8" />
	<size_alignment_map>
		<entry size="1" alignment="1" />
		<entry size="2" alignment="1" />
		<entry size="4" alignment="1" />
		<entry size="8" alignment="1" />
	</size_alignment_map>
  </data_organization>

  <global>
    <range space="ram"/>
  </global>

  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>

  <default_proto>
    <prototype name="__stdcall" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="F0"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="L0"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="R0"/>
        </pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="R1" piece2="R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="R3"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="R6"/>
        <register name="R7"/>
        <register name="FP"/>
        <register name="SB"/>
        <register name="SP"/>
        <register name="INTBASE"/>
        <register name="MOD"/>
      </unaffected>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
        <register name="R2"/>
        <register name="F0"/>
        <register name="F1"/>
        <register name="F2"/>
        <register name="F3"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
