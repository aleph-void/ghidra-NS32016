# National Semiconductor NS32532 (Series 32000) with NS32381 FPU and on-chip MMU.
#
# GENERATED by tools/gen_ns32016.py -- edit the generator, not this file.
#
# Layout of an instruction: opcode byte(s), then one index byte for each scaled-index general
# operand, then the addressing extensions of general operand 1 and 2, then any trailing
# immediate/displacement.  SLEIGH tables for the pieces after the opcode cannot see the opcode
# token, so the opcode constructor copies the two 5-bit addressing-mode fields into context
# (m1/m2: mode in the opcode, b1/b2: base mode, which an index byte replaces).

define endian=little;
define alignment=1;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

# general registers (word, halfword and byte views for sized operands)
define register offset=0x00 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x00 size=2 [ R0w _ R1w _ R2w _ R3w _ R4w _ R5w _ R6w _ R7w _ ];
define register offset=0x00 size=1 [ R0b _ _ _ R1b _ _ _ R2b _ _ _ R3b _ _ _
                                     R4b _ _ _ R5b _ _ _ R6b _ _ _ R7b _ _ _ ];

# dedicated registers.  SP is the stack pointer currently selected by PSR.S; SPB is the other
# one (it is swapped in and out whenever PSR.S changes), so SP always names the live stack.
define register offset=0x20 size=4 [ PC SB FP SP SPB INTBASE ];
define register offset=0x40 size=2 [ MOD ];
define register offset=0x44 size=4 [ CFG ];
# NS32532 debug, cache and configuration registers (LPR/SPR)
define register offset=0x48 size=4 [ DCR BPC DSR CAR ];

# PSR flags as separate bytes: C carry, T trace, L low, F flag/overflow, Z zero, N negative,
# U user mode, S stack select, P trace pending, I interrupt enable, V overflow trap enable (NS32532)
define register offset=0x70 size=1 [ C T L F Z N U S P I V ];

# NS32381 floating-point unit: eight 64-bit registers L0-L7; a single-precision operand uses the
# low half of the register with the same number
define register offset=0x60 size=4 [ FSR ];
define register offset=0x80 size=8 [ L0 L1 L2 L3 L4 L5 L6 L7 ];
define register offset=0x80 size=4 [ F0 _ F1 _ F2 _ F3 _ F4 _ F5 _ F6 _ F7 _ ];

# NS32532 on-chip memory-management unit registers (LMR/SMR)
define register offset=0xc0 size=4 [ MCR MSR TEAR PTB0 PTB1 ];
define register offset=0x100 size=4 [ contextreg ];

define context contextreg
	m1=(0,4) noflow
	m2=(5,9) noflow
	b1=(10,14) noflow
	b1t=(10,11) noflow
	b1r=(12,14) noflow
	b1rB=(12,14) noflow
	b1rW=(12,14) noflow
	b1rD=(12,14) noflow
	b1rF=(12,14) noflow
	b1rL=(12,14) noflow
	b1xB=(12,14) noflow
	b1xW=(12,14) noflow
	b1xD=(12,14) noflow
	b2=(15,19) noflow
	b2t=(15,16) noflow
	b2r=(17,19) noflow
	b2rB=(17,19) noflow
	b2rW=(17,19) noflow
	b2rD=(17,19) noflow
	b2rF=(17,19) noflow
	b2rL=(17,19) noflow
	b2xB=(17,19) noflow
	b2xW=(17,19) noflow
	b2xD=(17,19) noflow
	xr1c=(20,22) noflow
	xr1=(20,22) noflow
	xr2c=(23,25) noflow
	xr2=(23,25) noflow
;

define token ob(8)
	b0=(0,7)
	lo4=(0,3)
	hi4=(4,7)
;

# the 16-bit word after the first byte (formats 5-14) or the first 16 bits (formats 2-4)
define token ow(16)
	isz=(0,1)
	fbit=(0,0)
	m23=(2,3)
	op3=(4,6)
	op4=(2,5)
	fop=(3,5)
	f2=(2,2)
	b1bit=(1,1)
	b6=(6,6)
	q4=(7,10)
	qs=(7,10) signed
	stT=(7,7)
	stB=(8,8)
	stUW=(9,10)
	cfgo=(7,10)
	g2=(6,10)
	g1=(11,15)
	g2c=(6,10)
	g1c=(11,15)
	fr=(3,5)
;

# index byte of a scaled-index operand
define token idxb(8)
	ixr=(0,2)
	ixm=(3,7)
;

# register list byte (SAVE, RESTORE, ENTER, EXIT)
define token rlb(8)
	rl=(0,7)
;

# INSS/EXTS immediate byte: bits 7-5 offset, bits 4-0 length-1
define token bfb(8)
	bfo=(5,7)
	bfl=(0,4)
;

# variable-length displacements (most significant byte first, size in the top bits)
define token d8(8) endian=big
	d8top=(7,7)
	d8v=(0,6) signed
;
define token d16(16) endian=big
	d16top=(14,15)
	d16v=(0,13) signed
;
define token d32(32) endian=big
	d32top=(30,31)
	d32v=(0,29) signed
;

# immediate operands are stored most significant byte first
define token im8(8)
	iv8=(0,7)
;
define token im16(16) endian=big
	iv16=(0,15)
;
define token im32(32) endian=big
	iv32=(0,31)
;
define token im64(64) endian=big
	iv64=(0,63)
;

attach variables [ xr1 xr2 ixr b1r b2r b1rD b2rD ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ b1rB b2rB ] [ R0b R1b R2b R3b R4b R5b R6b R7b ];
attach variables [ b1rW b2rW ] [ R0w R1w R2w R3w R4w R5w R6w R7w ];
attach variables [ b1rF b2rF ] [ F0 F1 F2 F3 F4 F5 F6 F7 ];
attach variables [ b1rL b2rL ] [ L0 L1 L2 L3 L4 L5 L6 L7 ];
# the register that pairs with Rn (n xor 1), for the double-width MEI/DEI operands
attach variables [ b1xB b2xB ] [ R1b R0b R3b R2b R5b R4b R7b R6b ];
attach variables [ b1xW b2xW ] [ R1w R0w R3w R2w R5w R4w R7w R6w ];
attach variables [ b1xD b2xD ] [ R1 R0 R3 R2 R5 R4 R7 R6 ];
attach variables [ fr ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];

define pcodeop ns32k_svc;
define pcodeop ns32k_bpt;
define pcodeop ns32k_flag_trap;
define pcodeop ns32k_dvz_trap;
define pcodeop ns32k_ill_trap;
define pcodeop ns32k_wait;
define pcodeop ns32k_eoi;
define pcodeop ns32k_rdval;
define pcodeop ns32k_wrval;
define pcodeop ns32k_cinv;
define pcodeop ns32k_tlb_purge;
define pcodeop ns32381_poly;
define pcodeop ns32381_dot;
define pcodeop ns32381_scalb;
define pcodeop ns32381_logb;

# --- PSR helpers -----------------------------------------------------------------------------

# switch the live stack pointer when PSR.S changes
macro set_stack_select(ns) {
	local old = S;
	S = ns;
	if (old == ns) goto <keep>;
	local t = SP;
	SP = SPB;
	SPB = t;
	<keep>
}

macro psr_pack(r) {
	local t:2 = 0;
	t = t | zext(C) | (zext(T) << 1) | (zext(L) << 2) | (zext(V) << 4) | (zext(F) << 5) | (zext(Z) << 6) | (zext(N) << 7)
	      | (zext(U) << 8) | (zext(S) << 9) | (zext(P) << 10) | (zext(I) << 11);
	r = t;
}

# load the user-accessible low byte (C T L F Z N)
macro psr_load_low(v) {
	C = (v & 0x01) != 0;
	T = (v & 0x02) != 0;
	L = (v & 0x04) != 0;
	V = (v & 0x10) != 0;
	F = (v & 0x20) != 0;
	Z = (v & 0x40) != 0;
	N = (v & 0x80) != 0;
}

# load all of PSR from a halfword
macro psr_load(v) {
	psr_load_low(v:1);
	U = (v & 0x0100) != 0;
	P = (v & 0x0400) != 0;
	I = (v & 0x0800) != 0;
	local ns = (v & 0x0200) != 0;
	set_stack_select(ns);
}

macro push4(v) {
	SP = SP - 4;
	*[ram]:4 SP = v;
}

macro pop4(v) {
	v = *[ram]:4 SP;
	SP = SP + 4;
}

# --- displacements and immediates ------------------------------------------------------------

dispA: d8v is d8top=0 & d8v { export *[const]:4 d8v; }
dispA: d16v is d16top=2 & d16v { export *[const]:4 d16v; }
dispA: d32v is d32top=3 & d32v { export *[const]:4 d32v; }
dispB: d8v is d8top=0 & d8v { export *[const]:4 d8v; }
dispB: d16v is d16top=2 & d16v { export *[const]:4 d16v; }
dispB: d32v is d32top=3 & d32v { export *[const]:4 d32v; }
dispC: d8v is d8top=0 & d8v { export *[const]:4 d8v; }
dispC: d16v is d16top=2 & d16v { export *[const]:4 d16v; }
dispC: d32v is d32top=3 & d32v { export *[const]:4 d32v; }

# branch destinations are relative to the start of the instruction
bdest: reloc is d8top=0 & d8v [ reloc = inst_start + d8v; ] { export *[ram]:4 reloc; }
bdest: reloc is d16top=2 & d16v [ reloc = inst_start + d16v; ] { export *[ram]:4 reloc; }
bdest: reloc is d32top=3 & d32v [ reloc = inst_start + d32v; ] { export *[ram]:4 reloc; }

# --- condition codes -------------------------------------------------------------------------

cc: "EQ" is hi4=0 { tmp:1 = Z; export tmp; }
cc: "NE" is hi4=1 { tmp:1 = !Z; export tmp; }
cc: "CS" is hi4=2 { tmp:1 = C; export tmp; }
cc: "CC" is hi4=3 { tmp:1 = !C; export tmp; }
cc: "HI" is hi4=4 { tmp:1 = L; export tmp; }
cc: "LS" is hi4=5 { tmp:1 = !L; export tmp; }
cc: "GT" is hi4=6 { tmp:1 = N; export tmp; }
cc: "LE" is hi4=7 { tmp:1 = !N; export tmp; }
cc: "FS" is hi4=8 { tmp:1 = F; export tmp; }
cc: "FC" is hi4=9 { tmp:1 = !F; export tmp; }
cc: "LO" is hi4=10 { tmp:1 = !L && !Z; export tmp; }
cc: "HS" is hi4=11 { tmp:1 = L || Z; export tmp; }
cc: "LT" is hi4=12 { tmp:1 = !N && !Z; export tmp; }
cc: "GE" is hi4=13 { tmp:1 = N || Z; export tmp; }

cc2: "EQ" is q4=0 { tmp:1 = Z; export tmp; }
cc2: "NE" is q4=1 { tmp:1 = !Z; export tmp; }
cc2: "CS" is q4=2 { tmp:1 = C; export tmp; }
cc2: "CC" is q4=3 { tmp:1 = !C; export tmp; }
cc2: "HI" is q4=4 { tmp:1 = L; export tmp; }
cc2: "LS" is q4=5 { tmp:1 = !L; export tmp; }
cc2: "GT" is q4=6 { tmp:1 = N; export tmp; }
cc2: "LE" is q4=7 { tmp:1 = !N; export tmp; }
cc2: "FS" is q4=8 { tmp:1 = F; export tmp; }
cc2: "FC" is q4=9 { tmp:1 = !F; export tmp; }
cc2: "LO" is q4=10 { tmp:1 = !L && !Z; export tmp; }
cc2: "HS" is q4=11 { tmp:1 = L || Z; export tmp; }
cc2: "LT" is q4=12 { tmp:1 = !N && !Z; export tmp; }
cc2: "GE" is q4=13 { tmp:1 = N || Z; export tmp; }
cc2: "R" is q4=14 { tmp:1 = 1; export tmp; }
cc2: "N" is q4=15 { tmp:1 = 0; export tmp; }

# --- index bytes -----------------------------------------------------------------------------

ix1: is m1 < 0x1c { }
ix1: is m1 >= 0x1c ; ixm & ixr [ b1 = ixm; xr1c = ixr; ] { }
ix2: is m2 < 0x1c { }
ix2: is m2 >= 0x1c ; ixm & ixr [ b2 = ixm; xr2c = ixr; ] { }

# --- effective addresses: base modes, then scaled index -------------------------------------
# general operand 1
eab1: b1rD is b1t=0 & b1rD { tmp:4 = b1rD; export tmp; }
eab1: dispA^"("^b1rD^")" is b1t=1 & b1rD ; dispA { tmp:4 = b1rD + dispA; export tmp; }
eab1: dispB^"("^dispA^"(FP))" is b1=0x10 ; dispA ; dispB { tmp:4 = *[ram]:4 (FP + dispA); tmp = tmp + dispB; export tmp; }
eab1: dispB^"("^dispA^"(SP))" is b1=0x11 ; dispA ; dispB { tmp:4 = *[ram]:4 (SP + dispA); tmp = tmp + dispB; export tmp; }
eab1: dispB^"("^dispA^"(SB))" is b1=0x12 ; dispA ; dispB { tmp:4 = *[ram]:4 (SB + dispA); tmp = tmp + dispB; export tmp; }
eab1: "@"^dispA is b1=0x15 ; dispA { tmp:4 = dispA; export tmp; }
eab1: "EXT("^dispA^")+"^dispB is b1=0x16 ; dispA ; dispB { modz:4 = zext(MOD); linkt:4 = *[ram]:4 (modz + 4); ent:4 = *[ram]:4 (linkt + (dispA * 4)); tmp:4 = ent + dispB; export tmp; }
eab1: "TOS" is b1=0x17 { tmp:4 = SP; export tmp; }
eab1: dispA^"(FP)" is b1=0x18 ; dispA { tmp:4 = FP + dispA; export tmp; }
eab1: dispA^"(SP)" is b1=0x19 ; dispA { tmp:4 = SP + dispA; export tmp; }
eab1: dispA^"(SB)" is b1=0x1a ; dispA { tmp:4 = SB + dispA; export tmp; }
eab1: "*+"^dispA is b1=0x1b ; dispA { tmp:4 = inst_start + dispA; export tmp; }
ea1: eab1 is m1 < 0x1c & eab1 { export eab1; }
ea1: eab1^"["^xr1^":B]" is m1=0x1c & xr1 & eab1 { tmp:4 = eab1 + (xr1); export tmp; }
ea1: eab1^"["^xr1^":W]" is m1=0x1d & xr1 & eab1 { tmp:4 = eab1 + (xr1 << 1); export tmp; }
ea1: eab1^"["^xr1^":D]" is m1=0x1e & xr1 & eab1 { tmp:4 = eab1 + (xr1 << 2); export tmp; }
ea1: eab1^"["^xr1^":Q]" is m1=0x1f & xr1 & eab1 { tmp:4 = eab1 + (xr1 << 3); export tmp; }
# general operand 2
eab2: b2rD is b2t=0 & b2rD { tmp:4 = b2rD; export tmp; }
eab2: dispA^"("^b2rD^")" is b2t=1 & b2rD ; dispA { tmp:4 = b2rD + dispA; export tmp; }
eab2: dispB^"("^dispA^"(FP))" is b2=0x10 ; dispA ; dispB { tmp:4 = *[ram]:4 (FP + dispA); tmp = tmp + dispB; export tmp; }
eab2: dispB^"("^dispA^"(SP))" is b2=0x11 ; dispA ; dispB { tmp:4 = *[ram]:4 (SP + dispA); tmp = tmp + dispB; export tmp; }
eab2: dispB^"("^dispA^"(SB))" is b2=0x12 ; dispA ; dispB { tmp:4 = *[ram]:4 (SB + dispA); tmp = tmp + dispB; export tmp; }
eab2: "@"^dispA is b2=0x15 ; dispA { tmp:4 = dispA; export tmp; }
eab2: "EXT("^dispA^")+"^dispB is b2=0x16 ; dispA ; dispB { modz:4 = zext(MOD); linkt:4 = *[ram]:4 (modz + 4); ent:4 = *[ram]:4 (linkt + (dispA * 4)); tmp:4 = ent + dispB; export tmp; }
eab2: "TOS" is b2=0x17 { tmp:4 = SP; export tmp; }
eab2: dispA^"(FP)" is b2=0x18 ; dispA { tmp:4 = FP + dispA; export tmp; }
eab2: dispA^"(SP)" is b2=0x19 ; dispA { tmp:4 = SP + dispA; export tmp; }
eab2: dispA^"(SB)" is b2=0x1a ; dispA { tmp:4 = SB + dispA; export tmp; }
eab2: "*+"^dispA is b2=0x1b ; dispA { tmp:4 = inst_start + dispA; export tmp; }
ea2: eab2 is m2 < 0x1c & eab2 { export eab2; }
ea2: eab2^"["^xr2^":B]" is m2=0x1c & xr2 & eab2 { tmp:4 = eab2 + (xr2); export tmp; }
ea2: eab2^"["^xr2^":W]" is m2=0x1d & xr2 & eab2 { tmp:4 = eab2 + (xr2 << 1); export tmp; }
ea2: eab2^"["^xr2^":D]" is m2=0x1e & xr2 & eab2 { tmp:4 = eab2 + (xr2 << 2); export tmp; }
ea2: eab2^"["^xr2^":Q]" is m2=0x1f & xr2 & eab2 { tmp:4 = eab2 + (xr2 << 3); export tmp; }

# --- arithmetic macros (one per operand size) ---------------------------------------------

macro add_B(a,b,r) {
	local x:1 = a; local y:1 = b; local z:1 = x + y;
	C = carry(x,y); F = scarry(x,y); r = z;
}
macro addc_B(a,b,r) {
	local x:1 = a; local y:1 = b; local cin:1 = zext(C);
	local t:1 = x + y; local z:1 = t + cin;
	C = carry(x,y) || carry(t,cin); F = ((~(x ^ y)) & (x ^ z)) s< 0; r = z;
}
macro sub_B(a,b,r) {
	local x:1 = a; local y:1 = b; local z:1 = y - x;
	C = y < x; F = sborrow(y,x); r = z;
}
macro subc_B(a,b,r) {
	local x:1 = a; local y:1 = b; local cin:1 = zext(C);
	local t:1 = y - x; local z:1 = t - cin;
	C = (y < x) || ((y == x) && (cin != 0)); F = (((x ^ y) & (y ^ z)) s< 0); r = z;
}
macro cmp_B(a,b) {
	local x:1 = a; local y:1 = b;
	Z = x == y; N = x s> y; L = x > y;
}
macro neg_B(a,r) {
	local x:1 = a;
	C = x != 0; F = x == 0x80; r = 0 - x;
}
macro abs_B(a,r) {
	local x:1 = a;
	F = x == 0x80; r = x;
	if (x s>= 0) goto <pos>;
	r = 0 - x;
	<pos>
}

macro add_W(a,b,r) {
	local x:2 = a; local y:2 = b; local z:2 = x + y;
	C = carry(x,y); F = scarry(x,y); r = z;
}
macro addc_W(a,b,r) {
	local x:2 = a; local y:2 = b; local cin:2 = zext(C);
	local t:2 = x + y; local z:2 = t + cin;
	C = carry(x,y) || carry(t,cin); F = ((~(x ^ y)) & (x ^ z)) s< 0; r = z;
}
macro sub_W(a,b,r) {
	local x:2 = a; local y:2 = b; local z:2 = y - x;
	C = y < x; F = sborrow(y,x); r = z;
}
macro subc_W(a,b,r) {
	local x:2 = a; local y:2 = b; local cin:2 = zext(C);
	local t:2 = y - x; local z:2 = t - cin;
	C = (y < x) || ((y == x) && (cin != 0)); F = (((x ^ y) & (y ^ z)) s< 0); r = z;
}
macro cmp_W(a,b) {
	local x:2 = a; local y:2 = b;
	Z = x == y; N = x s> y; L = x > y;
}
macro neg_W(a,r) {
	local x:2 = a;
	C = x != 0; F = x == 0x8000; r = 0 - x;
}
macro abs_W(a,r) {
	local x:2 = a;
	F = x == 0x8000; r = x;
	if (x s>= 0) goto <pos>;
	r = 0 - x;
	<pos>
}

macro add_D(a,b,r) {
	local x:4 = a; local y:4 = b; local z:4 = x + y;
	C = carry(x,y); F = scarry(x,y); r = z;
}
macro addc_D(a,b,r) {
	local x:4 = a; local y:4 = b; local cin:4 = zext(C);
	local t:4 = x + y; local z:4 = t + cin;
	C = carry(x,y) || carry(t,cin); F = ((~(x ^ y)) & (x ^ z)) s< 0; r = z;
}
macro sub_D(a,b,r) {
	local x:4 = a; local y:4 = b; local z:4 = y - x;
	C = y < x; F = sborrow(y,x); r = z;
}
macro subc_D(a,b,r) {
	local x:4 = a; local y:4 = b; local cin:4 = zext(C);
	local t:4 = y - x; local z:4 = t - cin;
	C = (y < x) || ((y == x) && (cin != 0)); F = (((x ^ y) & (y ^ z)) s< 0); r = z;
}
macro cmp_D(a,b) {
	local x:4 = a; local y:4 = b;
	Z = x == y; N = x s> y; L = x > y;
}
macro neg_D(a,r) {
	local x:4 = a;
	C = x != 0; F = x == 0x80000000; r = 0 - x;
}
macro abs_D(a,r) {
	local x:4 = a;
	F = x == 0x80000000; r = x;
	if (x s>= 0) goto <pos>;
	r = 0 - x;
	<pos>
}

# block length operands of MOVM/CMPM: (displacement / element size) + 1 elements
blenB: cnt is d8top=0 & d8v [ cnt = (d8v / 1) + 1; ] { export *[const]:4 cnt; }
blenB: cnt is d16top=2 & d16v [ cnt = (d16v / 1) + 1; ] { export *[const]:4 cnt; }
blenB: cnt is d32top=3 & d32v [ cnt = (d32v / 1) + 1; ] { export *[const]:4 cnt; }
blenW: cnt is d8top=0 & d8v [ cnt = (d8v / 2) + 1; ] { export *[const]:4 cnt; }
blenW: cnt is d16top=2 & d16v [ cnt = (d16v / 2) + 1; ] { export *[const]:4 cnt; }
blenW: cnt is d32top=3 & d32v [ cnt = (d32v / 2) + 1; ] { export *[const]:4 cnt; }
blenD: cnt is d8top=0 & d8v [ cnt = (d8v / 4) + 1; ] { export *[const]:4 cnt; }
blenD: cnt is d16top=2 & d16v [ cnt = (d16v / 4) + 1; ] { export *[const]:4 cnt; }
blenD: cnt is d32top=3 & d32v [ cnt = (d32v / 4) + 1; ] { export *[const]:4 cnt; }

# --- register lists (SAVE/ENTER push in R0..R7 order, RESTORE/EXIT pop with the bits reversed)
rlsave: "[]" is rl=0 { }
rlsave: "[R0]" is rl=1 {
	SP = SP - 4; *[ram]:4 SP = R0;
}
rlsave: "[R1]" is rl=2 {
	SP = SP - 4; *[ram]:4 SP = R1;
}
rlsave: "[R0,R1]" is rl=3 {
	SP = SP - 4; *[ram]:4 SP = R0;
	SP = SP - 4; *[ram]:4 SP = R1;
}
rlsave: "[R2]" is rl=4 {
	SP = SP - 4; *[ram]:4 SP = R2;
}
rlsave: "[R0,R2]" is rl=5 {
	SP = SP - 4; *[ram]:4 SP = R0;
	SP = SP - 4; *[ram]:4 SP = R2;
}
rlsave: "[R1,R2]" is rl=6 {
	SP = SP - 4; *[ram]:4 SP = R1;
