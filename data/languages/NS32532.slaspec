# --- instructions -------------------------------------------------------------------------
:B^cc bdest is lo4=0xa & cc ; bdest {
if (cc) goto bdest;
}
:BR bdest is lo4=0xa & hi4=14 ; bdest {
goto bdest;
}
:BN bdest is lo4=0xa & hi4=15 ; bdest {

}
:BSR bdest is lo4=2 & hi4=0 ; bdest {
local ret:4 = inst_next;
push4(ret);
call bdest;
}
:RET dispC is lo4=2 & hi4=1 ; dispC {
local pc:4 = 0;
pop4(pc);
SP = SP + dispC;
return [pc];
}
:CXP dispC is lo4=2 & hi4=2 ; dispC {
local modz:4 = zext(MOD);
local linkt:4 = *[ram]:4 (modz + 4);
local desc:4 = *[ram]:4 (linkt + (dispC * 4));
SP = SP - 4;
*[ram]:2 SP = MOD;
local ret:4 = inst_next;
push4(ret);
local nm:2 = desc:2;
local nmz:4 = zext(nm);
SB = *[ram]:4 nmz;
local base:4 = *[ram]:4 (nmz + 8);
local pc:4 = base + (desc >> 16);
MOD = nm;
call [pc];
}
:RXP dispC is lo4=2 & hi4=3 ; dispC {
local pc:4 = 0;
pop4(pc);
local nm:2 = *[ram]:2 SP;
SP = SP + 4;
local nmz:4 = zext(nm);
SB = *[ram]:4 nmz;
MOD = nm;
SP = SP + dispC;
return [pc];
}
:RETT dispC is lo4=2 & hi4=4 ; dispC {
if (U == 0) goto <priv_ok>;
ns32k_ill_trap();
goto <priv_end>;
<priv_ok>
local pc:4 = *[ram]:4 SP;
local nm:2 = *[ram]:2 (SP + 4);
local ps:2 = *[ram]:2 (SP + 6);
local nmz:4 = zext(nm);
MOD = nm;
SB = *[ram]:4 nmz;
SP = SP + 8;
psr_load(ps);
SP = SP + dispC;
