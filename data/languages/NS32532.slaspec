# --- general operand tables ---------------------------------------------------------------
# G<pos><size><access>: size B W D (integer) F L (float); access r read, w write, m read-modify-write
G1Bm: b1rB is m1 < 8 & b1rB { export b1rB; }
G1Bm: "TOS" is m1=0x17 { export *[ram]:1 SP; }
G1Bm: ea1 is m1 >= 8 & m1 != 0x13 & m1 != 0x14 & m1 != 0x17 & ea1 { ptr:4 = ea1; export *[ram]:1 ptr; }
G1Br: b1rB is m1 < 8 & b1rB { export b1rB; }
